  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Add expense", "short_name": "Add", "url": "./?action=add", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Statistics", "short_name": "Stats", "url": "./?view=stats", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "My Plan", "short_name": "Plan", "url": "./?view=plan", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
